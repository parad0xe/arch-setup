#!/bin/bash

# Display git log with a graph view
glg() {
    # Log format: hash, author, date, relative time, decorations, subject
    local log_format="%C(bold #7873ad)%h%C(reset) - %C(#a791cb)<%an>%C(reset) %C(#8180ae)%ad (%ar)%C(reset)%C(bold #ffc777)%d%C(reset)%n     %C(#e6e6ec)%s%C(reset)%n%n"

    git log --graph --abbrev-commit --decorate --date=format-local:'%Y-%m-%d %H:%M' \
        --format=tformat:"$log_format" "$@"
}

glg "$@"
