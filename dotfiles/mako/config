# ==========================================
# MAKO NOTIFICATION CONFIGURATION
# ==========================================

# --- POSITION & LAYOUT ---
layer=overlay
anchor=top-right
margin=20
padding=15
width=350

# --- VISUALS (Rounded & Floating) ---
# Fond gris foncé/bleuté avec 90% d'opacité (e6 à la fin)
background-color=#1e1e2ee6
text-color=#cdd6f4
border-size=2
border-color=#b4befe
border-radius=15
font=JetBrainsMono Nerd Font 12

# --- BEHAVIOR ---
default-timeout=5000
ignore-timeout=1
max-visible=5
sort=-time

# --- ICONS ---
icons=1
max-icon-size=48

# --- URGENCY LEVELS ---
[urgency=low]
border-color=#313244

[urgency=high]
border-color=#f38ba8
default-timeout=0
