/* ==========================================
 * ROFI THEME - WALLPAPER GRID
 * ========================================== */

* {
    bg-col:  #1e1e2e;
    bg-col-light: #313244;
    border-col: #89b4fa;
    selected-col: #313244;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 800px;
    padding: 20px;
    background-color: @bg-col;
    border: 2px solid;
    border-color: @border-col;
    border-radius: 10px;
}

mainbox {
    background-color: @bg-col;
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 2px;
    margin: 0px 0px 20px 0px;
}

prompt {
    background-color: @blue;
    padding: 8px 15px;
    text-color: @bg-col;
    border-radius: 5px;
}

entry {
    padding: 8px;
    margin: 0px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
}

listview {
    columns: 4;
    lines: 3;
    background-color: @bg-col;
    fixed-height: false;
    spacing: 15px;
}

/* Switches elements from horizontal to vertical for grid display */
element {
    padding: 10px;
    background-color: @bg-col;
    text-color: @fg-col;
    orientation: vertical;
    border-radius: 8px;
}

element-icon {
    size: 140px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 10";
    margin: 5px 0px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @blue;
    border: 2px solid;
    border-color: @blue;
}
