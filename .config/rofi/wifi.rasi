/* Custom Rofi theme for Wi-Fi selection */

* {
    /* --- COULEURS (Inspiré de ton Mako) --- */
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    accent: #89b4fa;
    
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 400px;
    background-color: @bg;
    border: 2px solid;
    border-color: @accent;
    border-radius: 8px;
    padding: 15px;
    /* Centre la fenêtre au milieu de l'écran */
    location: center;
}

mainbox {
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 6px;
    padding: 8px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 12";
}

entry {
    placeholder: "Search network...";
    placeholder-color: #6c7086;
    cursor: text;
}

listview {
    lines: 6;
    spacing: 5px;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    vertical-align: 0.5;
    highlight: bold;
}
