#!/bin/bash

# Display git log with a graph view
glg() {
    # Log format: hash, date, relative time, decorations, subject, author
    local log_format="%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)"

    git log --graph --abbrev-commit --decorate --format=format:"$log_format" "$@"
}

glg "$@"
