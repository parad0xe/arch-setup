# ==========================================
# MAKO NOTIFICATION CONFIGURATION
# ==========================================

# --- POSITION & LAYOUT ---
layer=overlay
anchor=top-right
margin=15
padding=12
width=280

# --- VISUALS (Minimalist & Sleek) ---
background-color=#1e1e2ed6
text-color=#cdd6f4
border-size=1
border-color=#b4befe
border-radius=8
font=JetBrainsMono Nerd Font 10

# --- FORMATTING (Pango Markup) ---
format=<b>%s</b>\n<span size="xx-small">\n</span>%b

# --- PROGRESS BAR (Volume/Brightness) ---
progress-color=#89b4faCC

# --- BEHAVIOR ---
default-timeout=3000
ignore-timeout=1
max-visible=3
sort=-time

# --- ICONS ---
icons=1
max-icon-size=24
icon-location=left

# ==========================================
# DYNAMIC RULES
# ==========================================

[body=""]
format=%s
text-alignment=center

[summary=""]
text-alignment=center

# --- URGENCY LEVELS ---
[urgency=low]
border-color=#313244
default-timeout=2000

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
